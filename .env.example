# ============================================================
# TestDeck 配置文件模板
# 复制为 .env 后修改（.env 已被 .gitignore 排除，不会提交）。
# 优先级：真实环境变量 > 本文件 > 代码内置默认值。
# docker compose 也会读取本文件做变量替换，一处配置两处生效。
# ============================================================

# --- 安全（生产必改） ---
# TD_SECRET=change-me-to-a-long-random-string
# TD_ADMIN_PASSWORD=change-me

# --- 数据库（默认 SQLite 零配置；生产二选一） ---
# TD_DATABASE_URL=postgresql+psycopg2://testdeck:testdeck@localhost:5432/testdeck
# TD_DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/testdeck?charset=utf8mb4
# TD_DB=backend/testdeck.db

# --- 大模型（界面「模型配置」优先，此处仅兜底） ---
# TD_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TD_LLM_KEY=sk-xxx
# TD_LLM_MODEL=glm-4-flash

# --- 浏览器引擎（默认 Chromium Headless Shell） ---
# TD_BROWSER_ENGINE=lightpanda
# TD_LIGHTPANDA_URL=http://127.0.0.1:9222
# TD_LIGHTPANDA_BIN=/opt/lightpanda/lightpanda

# --- 其他 ---
# TD_KEEP_DAYS=30
# TD_SEED_DEMO=1

# --- 安全（可选） ---
# TD_CORS_ORIGINS=https://testdeck.example.com
# TD_GIT_WEBHOOK_SECRET=github-webhook-hmac-key

# --- 数据保留 ---
# TD_RUN_KEEP_DAYS=90
