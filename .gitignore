# ============================================================
# TestDeck .gitignore
# 原则：密钥/运行数据/本地产物不进仓库；模板与示例必须保留。
# ============================================================

# ---- 运行数据（含 API Key、凭据哈希、被测系统响应，绝不提交）----
backend/testdeck.db
backend/*.db
*.db
*.sqlite
*.sqlite3
backend/static/
logs/
*.log

# ---- 环境配置（.env 含密钥；模板 .env.example 必须提交）----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python（后端）----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# ---- Node（前端）----
frontend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
frontend/dist/

# ---- Playwright 测试产物（后续如新增浏览器测试）----
test-results/
playwright-report/
blob-report/

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ---- 本地工具产物 ----
.zcode/
.claude/
.aider*
.token_epoch
.secret_key
